    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/antoniomanitta/Documents/noprobagency/cold-email/data/cron.log</string>
  <key>StandardErrorPath</key><string>/Users/antoniomanitta/Documents/noprobagency/cold-email/data/cron.log</string>
